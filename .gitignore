node_modules/
__pycache__/
.DS_Store
runs/
screenshots/
public-bot/
public-client/

server.json
.env

backups/
.obsidian/

# Bot folders: keep scripts and lab logs stageable by explicit path, but always
# ignore credentials. Upstream ignored the whole directory, which made
# `git add bots/<name>/script.ts` fail without -f.
bots/*/*
!bots/_template/
!bots/*/*.ts
!bots/*/*.md
bots/*/bot.env

# Daemon type checker temp file
sdk/__exec_check.ts

# Upstream npm lockfile; this repo builds the engine with bun/bun.lock only.
# Deleted locally — ignore so vendor syncs don't silently reintroduce it.
server/engine/package-lock.json

# SDK is copied into Docker via Dockerfile; don't duplicate it under server/
server/sdk/
jobs/
# Goo fleet controller sources, supervisors and report tools live in bots/fleet/
# (private, mirrored on the exedev host) and are covered by bots/*/ above.

# Durable Grand Exchange ledger and SQLite WAL files
server/engine/data/market.sqlite*

# Generated when engine utilities are invoked from the repository root
/data/

# Dashboard state is live host data, not source.
/dashboard-max/data/
